# ===========================================================================
#  Supabase — projeto do AJ Progress Tracker
#  IMPORTANTE: este é um projeto Supabase PRÓPRIO do tracker.
#  NÃO é o banco do ERP (alissonerp). Nunca aponte para o banco do ERP.
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...     # anon (pública; a segurança vem das RLS policies)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...         # service_role — SÓ scripts/servidor, NUNCA no client

# Connection string usada SOMENTE por `npm run db:push`
# Supabase > Project Settings > Database > Connection string > URI (modo "Session")
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ===========================================================================
#  Twilio WhatsApp (opcional — notificação de progresso)
# ===========================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

NOME_APP=AJ Progress Tracker

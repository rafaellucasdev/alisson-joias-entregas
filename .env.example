# ===========================================================================
#  Supabase
#  Pegue em: Supabase > Project Settings > API
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # service_role (NUNCA exponha no client)

# Connection string usada SOMENTE pelo script `npm run db:push`
# Supabase > Project Settings > Database > Connection string > URI (modo "Session")
# Lembre de substituir [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ===========================================================================
#  Twilio WhatsApp (Sandbox gratuito)
#  Console: https://console.twilio.com  ->  Messaging > Try it out > WhatsApp
# ===========================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Número do sandbox (geralmente este). Mantenha o prefixo whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ===========================================================================
#  Loja (fictícia) — aparece na mensagem do WhatsApp
# ===========================================================================
NOME_LOJA=Mercado HoldPrint
